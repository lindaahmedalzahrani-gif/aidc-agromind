# Base URL the frontend uses to reach the AgroMind backend proxy.
#
# - Leave unset during local development: Vite proxies /api to the backend
#   server automatically (see vite.config.ts / server/.env.example).
# - In production, set this to wherever the backend proxy is deployed, e.g.
#   VITE_API_BASE_URL=https://api.agromind.example.com/api
VITE_API_BASE_URL=https://t02.aidc.nadir.sh
