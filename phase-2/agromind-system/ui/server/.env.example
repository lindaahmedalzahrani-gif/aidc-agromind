# --- Where this proxy is reachable from the frontend --------------------
PORT=8787

# --- Diagnosis model server ------------------------------------------
# Base URL of the fine-tuned vision-language model server (vLLM,
# OpenAI-compatible /v1/chat/completions), e.g:
#   MODEL_API_URL=http://<your-kubernetes-service-or-ingress>:8000
# Leave empty to run in "model not connected" mode: /api/diagnose will
# respond with a clear 503 instead of guessing at a fake diagnosis.
MODEL_API_URL=

# The exact prompt sent with every diagnosis image. Keep this in sync with
# whatever prompt the deployed model was benchmarked/tuned against.
MODEL_PROMPT_EN=Identify the crop and disease/pest shown in the image. Answer in the format 'crop, disease'. If it is a pest, also include the pest species. Return names only and do not provide an explanation.
MODEL_PROMPT_ZH=请识别图片中的作物和病虫害，按「作物，病害」格式回答；若为虫害，再补充具体虫种，按「作物，病害，虫种」。只回答名称，不要解释。

# --- RAG / knowledge assistant server ---------------------------------
# Base URL of the future RAG API, e.g:
#   RAG_API_URL=http://<your-rag-service>:8080
# Leave empty and /api/chat will return a clearly marked mock reply.
RAG_API_URL=

# --- CORS -----------------------------------------------------------
# Comma-separated list of allowed origins for the deployed frontend.
# Leave empty to allow all origins (fine for local development).
ALLOWED_ORIGINS=
